---
import '../styles/global.css';

const ideas = [
  ['IZAKAYA NIGHT','Grab a drink, order a few plates, and enjoy a casual Kyoto night together.'],
  ['KARAOKE','Sing, laugh, and experience a very Japanese night out.'],
  ['GAME CENTER & CRANE GAMES','Arcades, rhythm games, purikura, crane games — just for fun.'],
  ['SHOPPING TOGETHER','Stationery, gifts, local shops, Japanese products, or something very specific.'],
  ['SAKE SHOP & TACHINOMI','Browse a sake shop or stop at a standing bar and try something local.'],
  ['OMAKASE DINING','Want to try an omakase meal? I can help you navigate the experience.'],
  ['JAPANESE SWORDS','Interested in Japanese swords or specialist shops? Ask me.'],
  ['STATIONERY','From everyday Japanese stationery to specialist stores worth seeking out.'],
  ['KIMONO · CALLIGRAPHY · TEA','Culture without turning the whole day into a formal tour.'],
  ['ARASHIYAMA + MORE','Monkey Park, Hozugawa boat, Sagano Romantic Train, or your own unusual Kyoto idea.'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Ask Don | Your Kyoto Local</title>
  <meta name="description" content="Ask Don for the Kyoto experiences that are not really tours — izakaya, karaoke, game centers, shopping, sake, omakase dining and more." />
  <meta name="robots" content="noindex,nofollow" />
  <style>
    :root{--paper:#f5efe5;--ink:#181714;--gold:#b37b25;--blue:#35517b;--wood:#7a4f2f;--wood2:#95633c}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Georgia,'Times New Roman',serif}.ask-header{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;background:#f8f4ec;border-bottom:1px solid rgba(0,0,0,.08);position:relative;z-index:20}.ask-brand{font-size:1.35rem;font-weight:700;color:inherit;text-decoration:none}.ask-brand small{display:block;font-family:Arial,sans-serif;font-size:.62rem;letter-spacing:.12em;font-weight:400;margin-top:2px}.ask-nav{display:flex;align-items:center;gap:28px;font-family:Arial,sans-serif;font-size:.76rem;letter-spacing:.05em;text-transform:uppercase}.ask-nav a{color:inherit;text-decoration:none}.ask-nav .active{border-bottom:1px solid;padding-bottom:4px}.book{padding:11px 20px;border-radius:5px;background:var(--gold);color:white!important;text-transform:none;letter-spacing:0}
    .hero{min-height:620px;display:grid;grid-template-columns:43% 57%;overflow:hidden}.hero-copy{padding:76px 6vw 64px 5vw;position:relative;z-index:3}.scribble{display:inline-block;font-family:'Segoe Print','Bradley Hand',cursive;color:var(--blue);font-size:1.25rem;transform:rotate(-4deg);margin-bottom:34px}.hero h1{font-size:clamp(4.3rem,7vw,7.4rem);line-height:.85;letter-spacing:-.045em;margin:0 0 18px}.hero h2{font-size:clamp(1.8rem,2.7vw,3rem);font-weight:400;line-height:1.03;margin:0 0 24px}.hero-rule{width:44px;height:1px;background:#222;margin:24px 0}.hero p{font-size:1.12rem;line-height:1.55;max-width:540px}.hero-note{font-family:Arial,sans-serif;font-size:.82rem!important;letter-spacing:.08em;text-transform:uppercase;margin-top:24px}.ask-button{display:inline-flex;align-items:center;gap:18px;background:var(--gold);color:#fff;text-decoration:none;padding:14px 26px;border-radius:999px;font-family:Arial,sans-serif;margin-top:8px}.hero-photo{position:relative;min-height:620px;background:#222;clip-path:polygon(6% 0,100% 0,100% 100%,2% 100%,5% 91%,2% 82%,5% 72%,3% 62%,6% 52%,3% 42%,5% 32%,2% 22%,6% 11%)}.hero-photo img{width:100%;height:100%;object-fit:cover;display:block}.hero-photo::after{content:'Good people.\A Great stories.\A Kyoto.';white-space:pre;position:absolute;right:7%;top:17%;color:#fff;font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(1.4rem,2.2vw,2.3rem);line-height:1.25;transform:rotate(-7deg);text-shadow:0 2px 12px rgba(0,0,0,.3)}
    .intro{padding:88px 5vw 72px;max-width:1180px;margin:0 auto}.eyebrow{font-family:Arial,sans-serif;font-size:.78rem;letter-spacing:.16em;color:#6c5c49}.intro h2{font-size:clamp(2.7rem,5vw,5.2rem);line-height:.96;margin:12px 0 24px;max-width:980px}.intro p{font-size:1.25rem;line-height:1.65;max-width:820px;margin:0}.friend-line{margin-top:28px!important;font-family:'Segoe Print','Bradley Hand',cursive;color:var(--blue);font-size:1.45rem!important;transform:rotate(-1deg)}
    .desk{position:relative;padding:78px 5vw 100px;background:linear-gradient(90deg,rgba(74,41,21,.18),rgba(255,255,255,.03),rgba(59,32,16,.22)),repeating-linear-gradient(0deg,var(--wood) 0 54px,var(--wood2) 55px 57px);overflow:hidden}.desk-head{max-width:1180px;margin:0 auto 52px;display:flex;justify-content:space-between;gap:32px;align-items:flex-end;color:white}.desk-head h2{font-size:clamp(2.7rem,5vw,5rem);line-height:.95;margin:0}.desk-head p{font-family:'Segoe Print','Bradley Hand',cursive;font-size:1.45rem;max-width:340px;transform:rotate(3deg);margin:0}.idea-grid{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);gap:22px}.idea{min-height:235px;background:#f8f3e9;padding:24px 20px 26px;box-shadow:0 12px 20px rgba(0,0,0,.28);display:flex;flex-direction:column;justify-content:space-between}.idea:nth-child(odd){transform:rotate(-2deg)}.idea:nth-child(even){transform:rotate(2deg)}.idea:nth-child(3n){transform:rotate(3.5deg)}.idea strong{font-family:Arial,sans-serif;font-size:.82rem;letter-spacing:.1em;line-height:1.3}.idea p{font-size:1rem;line-height:1.45;margin:18px 0 0}.idea span{font-family:'Segoe Print','Bradley Hand',cursive;color:var(--blue);font-size:1rem;margin-top:22px}.notebook{max-width:1180px;margin:54px auto 0;background:#efe3c9;padding:28px 34px;box-shadow:0 12px 22px rgba(0,0,0,.24);transform:rotate(-1deg);display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}.notebook p{font-family:'Segoe Print','Bradley Hand',cursive;font-size:1.45rem;line-height:1.5;margin:0}.notebook strong{font-size:1.9rem}.closing{padding:92px 5vw 100px;text-align:center;background:var(--paper);position:relative}.closing::before{content:'';position:absolute;left:0;right:0;top:-18px;height:36px;background:var(--paper);clip-path:polygon(0 42%,4% 68%,8% 39%,13% 66%,18% 35%,23% 62%,29% 36%,34% 64%,40% 38%,45% 67%,51% 36%,58% 63%,64% 38%,70% 67%,77% 35%,83% 62%,90% 39%,95% 66%,100% 42%,100% 100%,0 100%)}.closing h2{font-size:clamp(2.7rem,5vw,5rem);margin:0 0 20px}.closing p{font-size:1.2rem;line-height:1.6;max-width:760px;margin:0 auto 28px}
    @media(max-width:1000px){.idea-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:900px){.ask-nav a:not(.book){display:none}.hero{grid-template-columns:1fr}.hero-copy{padding:54px 7vw}.hero-photo{min-height:430px;clip-path:polygon(0 4%,8% 2%,16% 5%,24% 2%,32% 5%,40% 2%,48% 5%,56% 2%,64% 5%,72% 2%,80% 5%,88% 2%,100% 5%,100% 100%,0 100%)}.desk-head{display:block}.desk-head p{margin-top:28px}.notebook{grid-template-columns:1fr}}@media(max-width:560px){.ask-header{padding:0 18px}.ask-brand{font-size:1.05rem}.book{padding:9px 14px}.hero h1{font-size:4rem}.idea-grid{grid-template-columns:1fr}.idea{transform:none!important}.hero-photo::after{font-size:1.25rem}.intro,.desk,.closing{padding-left:24px;padding-right:24px}}
  </style>
</head>
<body>
<header class="ask-header"><a class="ask-brand" href="/">Uma Academia<small>KYOTO PRIVATE GUIDE</small></a><nav class="ask-nav" aria-label="Primary"><a href="/">Home</a><a href="/#tours">Tours</a><a class="active" href="/ask-don">Ask Don</a><a href="/#about">About</a><a href="/#contact">Contact</a><a class="book" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don</a></nav></header>
<main>
<section class="hero"><div class="hero-copy"><span class="scribble">Kyoto is always better together.</span><h1>ASK DON</h1><h2>Not everything<br/>needs to be a tour.</h2><div class="hero-rule"></div><p>Want to hit an izakaya, sing karaoke, try a game center, shop for something special, browse a sake shop, or experience an omakase dinner? Tell me what you’re into. I’ll go with you.</p><p class="hero-note">BOOK MY TIME, NOT A PACKAGE.</p><a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don <span>→</span></a></div><div class="hero-photo"><img src="/guests/guest04.jpg" alt="Guests enjoying Kyoto together" /></div></section>
<section class="intro"><p class="eyebrow">YOUR KYOTO LOCAL</p><h2>Let’s just go do something fun in Kyoto.</h2><p>I’m a licensed private guide, but Ask Don is for the things that do not really feel like a guided tour. Sometimes you just want a local person who speaks English, knows Kyoto, and can come along.</p><p class="friend-line">Think of me as your Kyoto local.</p></section>
<section class="desk"><div class="desk-head"><div><p class="eyebrow" style="color:#e9dccb">ASK DON IDEAS</p><h2>What are you<br/>in the mood for?</h2></div><p>Drinks. Games. Shopping. Food. Culture. Weird requests welcome.</p></div><div class="idea-grid">{ideas.map(([title,text])=><article class="idea"><div><strong>{title}</strong><p>{text}</p></div><span>Ask Don →</span></article>)}</div><div class="notebook"><p><strong>Something else?</strong><br/>Tell me. If it is realistic, legal, and something I can help with, we can figure it out together.</p><a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Something%20Different">Just ask <span>→</span></a></div></section>
<section class="closing"><p class="eyebrow">NO FIXED MENU</p><h2>Your Kyoto. Your idea.</h2><p>You do not need to choose a standard tour. Tell me what you want to do, what you want to buy, what you want to eat, or where you want to go.</p><a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don <span>→</span></a></section>
</main>
</body>
</html>
