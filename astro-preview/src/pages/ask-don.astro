---
import '../styles/global.css';

const snapshots = [
  { src:'/gallery/kiyomizudera-family.jpg', alt:'Guests at Kiyomizu-dera in Kyoto', caption:'Classic Kyoto, at your pace.' },
  { src:'/recent-tour-arashiyama-family.jpg', alt:'Guests enjoying Arashiyama in Kyoto', caption:'Arashiyama, mixed your way.' },
  { src:'/gallery/guest-greenery.jpg', alt:'Guests enjoying a green temple garden in Kyoto', caption:'Quiet corners and local discoveries.' },
  { src:'/kyoto/yasaka-pagoda.jpg', alt:'Yasaka Pagoda and Higashiyama streets in Kyoto', caption:'Walk, wander, stop when you want.' },
  { src:'/kyoto/nijo-castle.jpg', alt:'Nijo Castle in Kyoto', caption:'History without a rigid schedule.' },
  { src:'/gallery/randen-station.jpg', alt:'Randen tram at a Kyoto station', caption:'Local transport can be part of the fun.' },
  { src:'/guests/guest02.jpg', alt:'Guests enjoying Kyoto together', caption:'Good company. Flexible plans.' },
  { src:'/guests/guest03.jpg', alt:'Guests enjoying a day in Kyoto', caption:'Change the plan as the day unfolds.' },
  { src:'/guests/guest04.jpg', alt:'Guests enjoying Kyoto together', caption:'Tell me what sounds fun.' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Ask Don | Your Kyoto Local</title>
  <meta name="description" content="Ask Don for the Kyoto experiences that are not really tours — izakaya, karaoke, game centers, shopping, sake, omakase dining and more." />
  <meta name="robots" content="noindex,nofollow" />
  <style>
    :root{--paper:#f5efe5;--ink:#181714;--gold:#b37b25;--blue:#35517b;--wood:#7a4f2f;--wood2:#95633c}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Georgia,'Times New Roman',serif}.ask-header{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;background:#f8f4ec;border-bottom:1px solid rgba(0,0,0,.08);position:relative;z-index:20}.ask-brand{font-size:1.35rem;font-weight:700;color:inherit;text-decoration:none}.ask-brand small{display:block;font-family:Arial,sans-serif;font-size:.62rem;letter-spacing:.12em;font-weight:400;margin-top:2px}.ask-nav{display:flex;align-items:center;gap:28px;font-family:Arial,sans-serif;font-size:.76rem;letter-spacing:.05em;text-transform:uppercase}.ask-nav a{color:inherit;text-decoration:none}.ask-nav .active{border-bottom:1px solid;padding-bottom:4px}.book{padding:11px 20px;border-radius:5px;background:var(--gold);color:white!important;text-transform:none;letter-spacing:0}
    .hero{min-height:330px;display:grid;grid-template-columns:43% 57%;overflow:hidden}.hero-copy{padding:28px 6vw 24px 5vw;position:relative;z-index:3}.scribble{display:inline-block;font-family:'Segoe Print','Bradley Hand',cursive;color:var(--blue);font-size:1.05rem;transform:rotate(-4deg);margin-bottom:12px}.hero h1{font-size:clamp(3.4rem,5.4vw,5.6rem);line-height:.85;letter-spacing:-.045em;margin:0 0 10px}.hero h2{font-size:clamp(1.35rem,2vw,2.15rem);font-weight:400;line-height:1.03;margin:0 0 10px}.hero-rule{width:40px;height:1px;background:#222;margin:10px 0}.hero p{font-size:.98rem;line-height:1.42;max-width:540px;margin:0}.hero-note{font-family:Arial,sans-serif;font-size:.72rem!important;letter-spacing:.08em;text-transform:uppercase;margin-top:10px!important}.ask-button{display:inline-flex;align-items:center;gap:18px;background:var(--gold);color:#fff;text-decoration:none;padding:11px 22px;border-radius:999px;font-family:Arial,sans-serif;margin-top:10px}.hero-photo{position:relative;min-height:330px;background:#222;clip-path:polygon(6% 0,100% 0,100% 100%,2% 100%,5% 91%,2% 82%,5% 72%,3% 62%,6% 52%,3% 42%,5% 32%,2% 22%,6% 11%)}.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center 45%;display:block}.hero-photo::after{content:'Good people.\A Great stories.\A Kyoto.';white-space:pre;position:absolute;right:7%;top:12%;color:#fff;font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(1.15rem,1.75vw,1.8rem);line-height:1.2;transform:rotate(-7deg);text-shadow:0 2px 12px rgba(0,0,0,.3)}
    .intro{padding:72px 5vw 60px;max-width:1180px;margin:0 auto}.eyebrow{font-family:Arial,sans-serif;font-size:.78rem;letter-spacing:.16em;color:#6c5c49}.intro h2{font-size:clamp(2.7rem,5vw,5.2rem);line-height:.96;margin:12px 0 24px;max-width:980px}.intro p{font-size:1.25rem;line-height:1.65;max-width:820px;margin:0}.friend-line{margin-top:28px!important;font-family:'Segoe Print','Bradley Hand',cursive;color:var(--blue);font-size:1.45rem!important;transform:rotate(-1deg)}
    .desk{position:relative;padding:78px 5vw 100px;background:linear-gradient(90deg,rgba(74,41,21,.18),rgba(255,255,255,.03),rgba(59,32,16,.22)),repeating-linear-gradient(0deg,var(--wood) 0 54px,var(--wood2) 55px 57px);overflow:hidden}.desk-head{max-width:1180px;margin:0 auto 52px;display:flex;justify-content:space-between;gap:32px;align-items:flex-end;color:white}.desk-head h2{font-size:clamp(2.7rem,5vw,5rem);line-height:.95;margin:0}.desk-head p{font-family:'Segoe Print','Bradley Hand',cursive;font-size:1.45rem;max-width:390px;transform:rotate(3deg);margin:0}.idea-list{max-width:1180px;margin:-18px auto 38px;color:#f4eadf;font-family:Arial,sans-serif;font-size:.83rem;letter-spacing:.07em;line-height:1.7;text-transform:uppercase}.idea-grid{max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr);gap:28px 22px;align-items:start}.idea{margin:0;background:#fffdf8;padding:10px 10px 18px;box-shadow:0 12px 20px rgba(0,0,0,.30);position:relative}.idea:nth-child(odd){transform:rotate(-3deg)}.idea:nth-child(even){transform:rotate(2.5deg)}.idea:nth-child(3n){transform:rotate(4deg) translateY(18px)}.idea:nth-child(4n){transform:rotate(-4deg) translateY(-8px)}.idea img{width:100%;height:170px;object-fit:cover;display:block}.idea figcaption{min-height:58px;padding:13px 8px 2px;display:flex;align-items:center;justify-content:center;text-align:center;font-family:'Segoe Print','Bradley Hand',cursive;color:#333;font-size:1rem;line-height:1.3}.notebook{max-width:1180px;margin:62px auto 0;background:#efe3c9;padding:28px 34px;box-shadow:0 12px 22px rgba(0,0,0,.24);transform:rotate(-1deg);display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center}.notebook p{font-family:'Segoe Print','Bradley Hand',cursive;font-size:1.45rem;line-height:1.5;margin:0}.notebook strong{font-size:1.9rem}.closing{padding:92px 5vw 100px;text-align:center;background:var(--paper);position:relative}.closing::before{content:'';position:absolute;left:0;right:0;top:-18px;height:36px;background:var(--paper);clip-path:polygon(0 42%,4% 68%,8% 39%,13% 66%,18% 35%,23% 62%,29% 36%,34% 64%,40% 38%,45% 67%,51% 36%,58% 63%,64% 38%,70% 67%,77% 35%,83% 62%,90% 39%,95% 66%,100% 42%,100% 100%,0 100%)}.closing h2{font-size:clamp(2.7rem,5vw,5rem);margin:0 0 20px}.closing p{font-size:1.2rem;line-height:1.6;max-width:760px;margin:0 auto 28px}
    @media(max-width:1000px){.idea-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:900px){.ask-nav a:not(.book){display:none}.hero{grid-template-columns:1fr}.hero-copy{padding:42px 7vw}.hero-photo{min-height:300px;clip-path:polygon(0 4%,8% 2%,16% 5%,24% 2%,32% 5%,40% 2%,48% 5%,56% 2%,64% 5%,72% 2%,80% 5%,88% 2%,100% 5%,100% 100%,0 100%)}.desk-head{display:block}.desk-head p{margin-top:28px}.notebook{grid-template-columns:1fr}}@media(max-width:560px){.ask-header{padding:0 18px}.ask-brand{font-size:1.05rem}.book{padding:9px 14px}.hero h1{font-size:4rem}.idea-grid{grid-template-columns:1fr}.idea{transform:none!important}.idea img{height:250px}.hero-photo::after{font-size:1.25rem}.intro,.desk,.closing{padding-left:24px;padding-right:24px}}
  </style>
</head>
<body>
<header class="ask-header"><a class="ask-brand" href="/">Uma Academia<small>KYOTO PRIVATE GUIDE</small></a><nav class="ask-nav" aria-label="Primary"><a href="/">Home</a><a href="/#tours">Tours</a><a class="active" href="/ask-don">Ask Don</a><a href="/#about">About</a><a href="/#contact">Contact</a><a class="book" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don</a></nav></header>
<main>
<section class="hero"><div class="hero-copy"><span class="scribble">Kyoto is always better together.</span><h1>ASK DON</h1><h2>Not everything<br/>needs to be a tour.</h2><div class="hero-rule"></div><p>Want to hit an izakaya, sing karaoke, try a game center, shop for something special, browse a sake shop, or experience an omakase dinner? Tell me what you’re into. I’ll go with you.</p><p class="hero-note">BOOK MY TIME, NOT A PACKAGE.</p><a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don <span>→</span></a></div><div class="hero-photo"><img src="/ask-don/hero-women.jpg" alt="Four guests enjoying Kyoto together" /></div></section>
<section class="intro"><p class="eyebrow">YOUR KYOTO LOCAL</p><h2>Let’s just go do something fun in Kyoto.</h2><p>I’m a licensed private guide, but Ask Don is for the things that do not really feel like a guided tour. Sometimes you just want a local person who speaks English, knows Kyoto, and can come along.</p><p class="friend-line">Think of me as your Kyoto local.</p></section>
<section class="desk"><div class="desk-head"><div><p class="eyebrow" style="color:#e9dccb">ASK DON IDEAS</p><h2>What are you<br/>in the mood for?</h2></div><p>Drinks. Games. Shopping. Food. Culture. Weird requests welcome.</p></div><p class="idea-list">Izakaya · Karaoke · Game centers · Crane games · Shopping · Sake · Tachinomi · Omakase dining · Japanese swords · Stationery · Kimono · Calligraphy · Tea · Arashiyama</p><div class="idea-grid">{snapshots.map((snapshot)=><figure class="idea"><img src={snapshot.src} alt={snapshot.alt} loading="lazy" decoding="async"/><figcaption>{snapshot.caption}</figcaption></figure>)}</div><div class="notebook"><p><strong>Something else?</strong><br/>Tell me. If it is realistic, legal, and something I can help with, we can figure it out together.</p><a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Something%20Different">Just ask <span>→</span></a></div></section>
<section class="closing"><p class="eyebrow">NO FIXED MENU</p><h2>Your Kyoto. Your idea.</h2><p>You do not need to choose a standard tour. Tell me what you want to do, what you want to buy, what you want to eat, or where you want to go.</p><a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don <span>→</span></a></section>
</main>
</body>
</html>
