---
import '../styles/global.css';

const memories = [
  { src: '/gallery/kiyomizudera-family.jpg', alt: 'Recent private guiding moment at Kiyomizu-dera', label: 'Kiyomizu-dera' },
  { src: '/recent-tour-arashiyama-family.jpg', alt: 'A recent private guiding day in Arashiyama', label: 'Arashiyama' },
  { src: '/gallery/guest-greenery.jpg', alt: 'Guests enjoying a green temple garden in Kyoto', label: 'Exploring together' },
  { src: '/kyoto/yasaka-pagoda.jpg', alt: 'Yasaka Pagoda and the historic Higashiyama streets in Kyoto', label: 'Hidden corners' },
  { src: '/kyoto/nijo-castle.jpg', alt: 'Nijo Castle in Kyoto', label: 'History & culture' },
  { src: '/gallery/randen-station.jpg', alt: 'Randen tram at a Kyoto station', label: 'Local transport' },
  { src: '/guests/guest02.jpg', alt: 'Recent private guiding moment in Kyoto', label: 'Good company' },
  { src: '/guests/guest03.jpg', alt: 'Recent private guiding moment in Kyoto', label: 'Kyoto memories' },
  { src: '/guests/guest04.jpg', alt: 'Recent private guiding moment in Kyoto', label: 'A day your way' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Ask Don | Uma Academia Kyoto Private Guide</title>
  <meta name="description" content="Explore Kyoto with Don. Not just sightseeing — tell me what you want to experience in Kyoto." />
  <meta name="robots" content="noindex,nofollow" />
  <style>
    :root{--paper:#f5efe5;--ink:#181714;--gold:#b37b25;--wood:#7a4f2f;--wood2:#9b6a42}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:Georgia,'Times New Roman',serif}
    .ask-header{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;background:#f8f4ec;border-bottom:1px solid rgba(0,0,0,.08);position:relative;z-index:20}
    .ask-brand{font-family:Georgia,'Times New Roman',serif;font-size:1.35rem;font-weight:700}.ask-brand small{display:block;font-family:Arial,sans-serif;font-size:.62rem;letter-spacing:.12em;font-weight:400;margin-top:2px}
    .ask-nav{display:flex;align-items:center;gap:28px;font-family:Arial,sans-serif;font-size:.76rem;letter-spacing:.05em;text-transform:uppercase}.ask-nav a{color:inherit;text-decoration:none}.ask-nav .active{border-bottom:1px solid;padding-bottom:4px}.book{padding:11px 20px;border-radius:5px;background:var(--gold);color:white!important;text-transform:none;letter-spacing:0}
    .ask-hero{min-height:610px;display:grid;grid-template-columns:44% 56%;background:var(--paper);overflow:hidden;position:relative}
    .hero-copy{padding:76px 7vw 68px 5vw;position:relative;z-index:3;background:var(--paper)}
    .scribble{font-family:'Segoe Print','Bradley Hand',cursive;color:#35517b;font-size:1.35rem;transform:rotate(-4deg);display:inline-block;margin-bottom:36px}
    .hero-copy h1{font-size:clamp(4rem,7vw,7.2rem);line-height:.86;margin:0 0 18px;letter-spacing:-.045em}
    .hero-copy h2{font-size:clamp(1.7rem,2.5vw,2.8rem);line-height:1.05;margin:0 0 26px;font-weight:400}
    .hero-copy p{font-size:1.1rem;line-height:1.55;max-width:520px;margin:0 0 28px}.hero-rule{width:42px;height:1px;background:#222;margin:24px 0}
    .ask-button{display:inline-flex;align-items:center;gap:18px;background:var(--gold);color:#fff;text-decoration:none;padding:14px 26px;border-radius:999px;font-family:Arial,sans-serif}
    .hero-photo{position:relative;min-height:610px;background:#222;clip-path:polygon(5% 0,100% 0,100% 100%,2% 100%,4% 92%,2% 84%,5% 76%,3% 66%,6% 57%,3% 48%,5% 39%,3% 29%,6% 20%,3% 10%)}
    .hero-photo img{width:100%;height:100%;object-fit:cover;display:block}.hero-photo::after{content:'Good people.\A Great stories.\A Kyoto.';white-space:pre;position:absolute;right:7%;top:17%;color:#fff;font-family:'Segoe Print','Bradley Hand',cursive;font-size:clamp(1.4rem,2.2vw,2.3rem);line-height:1.25;transform:rotate(-7deg);text-shadow:0 2px 12px rgba(0,0,0,.25)}
    .desk{position:relative;padding:70px 5vw 95px;min-height:1120px;background:linear-gradient(90deg,rgba(74,41,21,.18),rgba(255,255,255,.04),rgba(59,32,16,.22)),repeating-linear-gradient(0deg,var(--wood) 0 54px,var(--wood2) 55px 57px);overflow:hidden}
    .desk-title{color:white;font-family:'Segoe Print','Bradley Hand',cursive;font-size:2.2rem;line-height:1.1;transform:rotate(-4deg);width:250px;margin:0 0 30px}.notebook{position:absolute;right:5vw;top:56px;width:235px;background:#f4ead4;padding:26px 24px 30px;box-shadow:0 14px 28px rgba(0,0,0,.25);transform:rotate(5deg);font-family:'Segoe Print','Bradley Hand',cursive;font-size:1.2rem;line-height:1.7}.notebook strong{display:block;font-size:1.55rem;margin-top:8px}
    .memory-board{position:relative;max-width:1180px;height:930px;margin:0 auto}.memory{position:absolute;width:245px;background:#f8f3e9;padding:10px 10px 28px;box-shadow:0 10px 18px rgba(0,0,0,.3);margin:0}.memory img{width:100%;height:180px;object-fit:cover;display:block}.memory figcaption{text-align:center;margin-top:11px;font-family:'Segoe Print','Bradley Hand',cursive;font-size:1rem}
    .memory:nth-child(1){left:2%;top:110px;transform:rotate(-8deg)}.memory:nth-child(2){left:26%;top:0;transform:rotate(4deg)}.memory:nth-child(3){left:50%;top:70px;transform:rotate(7deg)}.memory:nth-child(4){right:1%;top:190px;transform:rotate(10deg)}.memory:nth-child(5){left:10%;top:420px;transform:rotate(5deg)}.memory:nth-child(6){left:37%;top:350px;transform:rotate(-3deg)}.memory:nth-child(7){right:15%;top:455px;transform:rotate(-7deg)}.memory:nth-child(8){left:25%;top:690px;transform:rotate(6deg)}.memory:nth-child(9){right:3%;top:700px;transform:rotate(4deg)}
    .closing{padding:84px 5vw 92px;text-align:center;background:var(--paper);position:relative}.closing::before{content:'';position:absolute;left:0;right:0;top:-18px;height:36px;background:var(--paper);clip-path:polygon(0 42%,4% 68%,8% 39%,13% 66%,18% 35%,23% 62%,29% 36%,34% 64%,40% 38%,45% 67%,51% 36%,58% 63%,64% 38%,70% 67%,77% 35%,83% 62%,90% 39%,95% 66%,100% 42%,100% 100%,0 100%)}.closing h2{font-size:clamp(2.3rem,4vw,4.2rem);margin:0 0 18px}.closing p{font-size:1.2rem;line-height:1.55;max-width:720px;margin:0 auto 30px}
    @media(max-width:900px){.ask-nav a:not(.book){display:none}.ask-hero{grid-template-columns:1fr}.hero-copy{padding:54px 7vw}.hero-photo{min-height:430px;clip-path:polygon(0 4%,8% 2%,16% 5%,24% 2%,32% 5%,40% 2%,48% 5%,56% 2%,64% 5%,72% 2%,80% 5%,88% 2%,100% 5%,100% 100%,0 100%)}.desk{padding-top:50px;min-height:auto}.notebook{position:relative;right:auto;top:auto;width:auto;max-width:280px;margin:0 0 45px auto}.memory-board{height:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.memory{position:relative!important;left:auto!important;right:auto!important;top:auto!important;width:auto!important;transform:none!important}.memory img{height:220px}}
    @media(max-width:560px){.ask-header{padding:0 18px}.ask-brand{font-size:1.05rem}.book{padding:9px 14px}.hero-copy h1{font-size:4rem}.memory-board{grid-template-columns:1fr}.memory img{height:250px}.hero-photo::after{font-size:1.35rem}.desk-title{font-size:1.8rem}}
  </style>
</head>
<body>
  <header class="ask-header">
    <a class="ask-brand" href="/">Uma Academia<small>KYOTO PRIVATE GUIDE</small></a>
    <nav class="ask-nav" aria-label="Primary">
      <a href="/">Home</a><a href="/#tours">Tours</a><a class="active" href="/ask-don">Ask Don</a><a href="/#about">About</a><a href="/#contact">Contact</a><a class="book" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don</a>
    </nav>
  </header>

  <main>
    <section class="ask-hero">
      <div class="hero-copy">
        <span class="scribble">Kyoto is always better together.</span>
        <h1>ASK DON</h1>
        <h2>More than a tour.<br/>Let’s explore Kyoto together.</h2>
        <div class="hero-rule"></div>
        <p>Not just sightseeing. Tell me what you want to experience in Kyoto. I’ll help you make it real.</p>
        <a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don <span>→</span></a>
      </div>
      <div class="hero-photo">
        <img src="/guests/guest04.jpg" alt="Recent private guiding moment in Kyoto" />
      </div>
    </section>

    <section class="desk" aria-label="Kyoto memories and ideas">
      <h2 class="desk-title">Memories<br/>made in Kyoto</h2>
      <aside class="notebook">Temples.<br/>Food.<br/>Hidden gems.<br/>Local life.<br/>And more.<strong>Just ask!</strong></aside>
      <div class="memory-board">
        {memories.map((memory)=><figure class="memory"><img src={memory.src} alt={memory.alt} loading="lazy" decoding="async"/><figcaption>{memory.label}</figcaption></figure>)}
      </div>
    </section>

    <section class="closing">
      <h2>Your Kyoto, Your Story</h2>
      <p>No fixed plans. Just tell me what you’re interested in.<br/>Let’s create a special day together.</p>
      <a class="ask-button" href="mailto:eltontanaka@gmail.com?subject=Ask%20Don%20-%20Kyoto%20Enquiry">Ask Don <span>→</span></a>
    </section>
  </main>
</body>
</html>
