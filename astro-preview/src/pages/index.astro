---
import '../styles/global.css';

const tours = [
  { title: 'First Time Kyoto', text: 'See the must-sees with context and stories.', image: '/kyoto/nijo-castle.jpg' },
  { title: 'Kyoto Highlights', text: 'A well-balanced day of history, nature and culture.', image: '/kyoto/fushimi-inari.jpg' },
  { title: 'Kyoto History', text: 'Go deeper into the stories that shaped the city.', image: '/kyoto/yasaka-pagoda.jpg' },
  { title: 'Family Kyoto', text: 'Engaging, flexible and fun for all ages.', image: '/recent-tour-arashiyama-family.jpg' },
  { title: 'Kyoto for Senior Travellers', text: 'A relaxed pace, with comfort and care.', image: '/guests/guest03.jpg' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Uma Academia | Private Kyoto Tours with Don</title>
    <meta name="description" content="Private Kyoto tours with Don, a Kyoto-born National Government Licensed Guide Interpreter. Calm, personal and local experiences mainly on weekends and public holidays." />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <a class="brand" href="#top" aria-label="Uma Academia home">
          <span class="brand-main">UMA ACADEMIA</span>
          <span class="brand-sub">Private Kyoto Tours with Don</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="#tours">Tours</a>
          <a href="#about">About</a>
          <a href="#stories">Stories</a>
          <a href="#faq">FAQ</a>
          <a href="#contact">Contact</a>
          <a class="pill dark" href="#contact"><span class="calendar">▣</span> Check a Date</a>
        </nav>
      </header>

      <main id="top">
        <section class="hero">
          <div class="hero-copy">
            <h1>KYOTO,<br />AT YOUR<br />OWN PACE.</h1>
            <p class="hero-kicker">Private Kyoto with Don.<br />Calm. Personal. Local.</p>
            <span class="short-rule"></span>
            <p class="hero-lead">Meaningful experiences.<br />Real connections.<br />A deeper Kyoto.</p>
            <div class="hero-actions">
              <a class="pill dark" href="#tours">Explore Our Tours <span>→</span></a>
              <a class="pill outline" href="#contact"><span class="calendar">▣</span> Check a Date</a>
            </div>
          </div>

          <div class="hero-collage" aria-label="Kyoto experiences">
            <figure class="slice slice-a"><img src="/kyoto-hero.jpg" alt="Kyoto scenery" /></figure>
            <figure class="slice slice-b">
              <img src="/don.jpg" alt="Don, private Kyoto guide" />
              <figcaption>Good<br />People<br />Make<br />a Brighter<br />Kyoto</figcaption>
            </figure>
            <figure class="slice slice-c"><img src="/guests/guest02.jpg" alt="A Kyoto travel moment" /></figure>
          </div>
        </section>

        <section id="tours" class="tour-section section-pad">
          <div class="section-head">
            <div>
              <p class="eyebrow">OUR TOURS</p>
              <h2>Different Ways<br />to Experience Kyoto</h2>
              <span class="short-rule"></span>
              <p class="section-copy">From iconic highlights to hidden gems,<br />all tours are private and tailored to your interests.</p>
            </div>
            <a class="underlink" href="#contact">View All Tours →</a>
          </div>

          <div class="tour-grid">
            {tours.map((tour) => (
              <article class="tour-card">
                <div class="tour-photo"><img src={tour.image} alt={tour.title} loading="lazy" decoding="async" /></div>
                <h3>{tour.title}</h3>
                <p>{tour.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="stories" class="story-banner">
          <img src="/recent-tour-arashiyama-family.jpg" alt="A private guiding day in Kyoto" loading="lazy" decoding="async" />
          <div class="story-shade"></div>
          <div class="story-copy">
            <blockquote>“Don made our time in Kyoto<br />truly special. His knowledge, kindness<br />and sense of humour brought the city to life.”</blockquote>
            <p>—&nbsp;&nbsp;Recent Guest</p>
          </div>
          <a class="pill story-button" href="#contact">More Stories <span>→</span></a>
        </section>

        <section id="about" class="about-section section-pad">
          <div class="about-copy">
            <p class="eyebrow">ABOUT DON</p>
            <h2>A Local Friend<br />in Kyoto</h2>
            <span class="short-rule"></span>
            <p>I’m Don, a Kyoto native. I love sharing the history, culture and everyday life of my city with travellers from around the world. My goal is simple — to help you feel at home in Kyoto.</p>
            <a class="pill outline" href="#contact">My Story <span>→</span></a>
          </div>

          <div class="about-photo"><img src="/don.jpg" alt="Don Tanaka, private Kyoto guide" loading="lazy" decoding="async" /></div>

          <aside class="price-card" id="contact">
            <p class="eyebrow">PRICING (GUIDELINE)</p>
            <dl>
              <div><dt>4 hours</dt><dd>¥40,000</dd></div>
              <div><dt>8 hours</dt><dd>¥80,000</dd></div>
              <div><dt>Extra hour</dt><dd>¥10,000</dd></div>
            </dl>
            <p class="small-note">All tours are private (your group only).<br />Entry fees, transportation and meals are additional.</p>
            <a class="pill dark full" href="mailto:eltontanaka@gmail.com?subject=Kyoto%20Private%20Guide%20Enquiry"><span class="calendar">▣</span> Check Availability</a>
            <p class="contact-note">Not sure which tour is right for you?<br />Feel free to contact me.</p>
            <a class="underlink contact-link" href="mailto:eltontanaka@gmail.com?subject=Kyoto%20Private%20Guide%20Enquiry">Contact Us →</a>
          </aside>
        </section>

        <section id="faq" class="sr-only" aria-label="FAQ placeholder"></section>
      </main>
    </div>
  </body>
</html>
