---
import '../styles/global.css';

const tourIdeas = [
  {
    title: 'First-Time Kyoto',
    text: "A relaxed introduction to Kyoto's essential sights and traditional neighbourhoods.",
    image: '/kyoto-hero.jpg',
  },
  {
    title: 'Kyoto Highlights',
    text: 'A full day shaped around the places you most want to experience.',
    image: '/kyoto/fushimi-inari.jpg',
  },
  {
    title: 'Kyoto at a Gentle Pace',
    text: 'Fewer stops, more time — ideal if you prefer a comfortable and unhurried day.',
    image: '/kyoto/nijo-castle.jpg',
  },
];

const guestImages = ['/guests/guest02.jpg','/guests/guest03.jpg','/guests/guest04.jpg'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Private Kyoto Guide | Don Tanaka, Licensed Guide Interpreter</title>
    <meta name="description" content="Private Kyoto guiding with Don Tanaka, a Kyoto-born National Government Licensed Guide Interpreter. Calm, flexible tours mainly on weekends and public holidays." />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">
        <span class="brand-main">uma academia</span>
        <span class="brand-sub">KYOTO LOCAL TOURS</span>
      </a>
      <nav aria-label="Primary">
        <a class="active" href="#top">Home</a>
        <a href="#about">About</a>
        <a href="#tours">Tour Ideas</a>
        <a href="#about">Private Guide</a>
        <a href="#contact">Contact</a>
        <a class="nav-cta" href="#contact">Plan Your Tour <span>→</span></a>
        <span class="lang">◎ EN⌄</span>
      </nav>
    </header>

    <main id="top">
      <section class="hero hero-fushimi">
        <img src="/kyoto/fushimi-inari.jpg" alt="Vermilion torii gates at Fushimi Inari Taisha in Kyoto" />
        <div class="hero-shade"></div>
        <div class="hero-copy wrap">
          <h1>Discover<br />Kyoto Differently</h1>
          <p class="hero-tagline">Local insights. Meaningful encounters.<br />Unforgettable moments.</p>
          <div class="actions">
            <a class="button primary" href="#contact">Plan Your Tour <span>→</span></a>
          </div>
        </div>

        <div class="hero-features wrap" aria-label="Why travel with Uma Academia">
          <div class="hero-feature"><span class="feature-icon">◯</span><div><strong>Small Groups</strong><small>More personal experiences</small></div></div>
          <div class="hero-feature"><span class="feature-icon">◇</span><div><strong>Local Insights</strong><small>Beyond the guidebooks</small></div></div>
          <div class="hero-feature"><span class="feature-icon">♡</span><div><strong>Meaningful Travel</strong><small>Real connections</small></div></div>
          <div class="hero-location"><strong>Fushimi Inari Taisha</strong><small>A journey through a thousand torii</small></div>
        </div>
      </section>

      <section class="editorial-intro">
        <div class="wrap editorial-inner">
          <p class="eyebrow">MORE THAN SIGHTSEEING</p>
          <h2>Thoughtful Tours for Curious Travelers</h2>
          <span class="editorial-rule"></span>
        </div>
      </section>

      <section class="split-section wrap experience">
        <div class="image-panel tall experience-photo">
          <img
            src="/kyoto/fushimi-inari.jpg"
            alt="Fushimi Inari shrine gates in Kyoto"
            width="1200"
            height="1600"
            decoding="async"
          />
        </div>
        <div class="copy-panel">
          <p class="eyebrow">YOUR DAY IN KYOTO</p>
          <h2>At your pace.</h2>
          <p class="lead">Kyoto does not need to be rushed.</p>
          <p>I will help you make the most of your time while keeping the day comfortable, flexible, and personal.</p>
          <p>First visit, travelling with family, or simply looking for a slower pace — we can shape the day around you.</p>
        </div>
      </section>

      <section class="arrival-section">
        <div class="wrap">
          <p class="eyebrow light">A DIFFERENT WAY TO START KYOTO</p>
          <div class="arrival-head">
            <h2>Arrive in Kyoto.<br />Start exploring.</h2>
            <p>Arriving by Shinkansen? I can meet you at Kyoto Station and start your private tour from there.</p>
          </div>
          <div class="steps">
            <article><span>01</span><h3>ARRIVE</h3><p>Meet Don at Kyoto Station.</p></article>
            <article><span>02</span><h3>LUGGAGE</h3><p>Use same-day luggage delivery when available.</p></article>
            <article><span>03</span><h3>EXPLORE</h3><p>Start sightseeing right away.</p></article>
            <article><span>04</span><h3>HOTEL</h3><p>Finish the tour at your hotel.</p></article>
          </div>
          <a class="text-link light" href="#tours">Explore the Arrival Tour →</a>
        </div>
      </section>

      <section id="tours" class="wrap tours-section">
        <div class="section-heading">
          <div><p class="eyebrow">TOUR IDEAS</p><h2>Ideas, not fixed packages.</h2></div>
          <p>Start with an idea. We can adjust the day around your interests, pace and location.</p>
        </div>
        <div class="tour-grid">
          {tourIdeas.map((tour) => (
            <article class="tour-card">
              <div class="tour-image"><img src={tour.image} alt={tour.title} loading="lazy" decoding="async" /></div>
              <h3>{tour.title}</h3>
              <p>{tour.text}</p>
            </article>
          ))}
        </div>
        <a class="text-link" href="#contact">Ask about a tour idea →</a>
      </section>

      <section class="guest-section">
        <div class="wrap">
          <p class="eyebrow">REAL DAYS IN KYOTO</p>
          <h2>Kyoto, shared.</h2>
          <p class="section-note">Recent guiding moments, shared with permission.</p>
          <div class="guest-grid">
            <img
              src="/recent-tour-arashiyama-family.jpg"
              alt="A recent private guiding day in Arashiyama"
              width="1400"
              height="1050"
              loading="lazy"
              decoding="async"
            />
            {guestImages.map((image, i) => <img src={image} alt={`Recent private guiding moment in Kyoto ${i + 2}`} loading="lazy" decoding="async" />)}
          </div>
        </div>
      </section>

      <section class="rates-section wrap">
        <div><p class="eyebrow">RATES</p><h2>Simple, clear pricing.</h2></div>
        <div class="rate-grid">
          <article><p>HALF DAY</p><span>4 hours</span><strong>¥40,000</strong></article>
          <article><p>FULL DAY</p><span>8 hours</span><strong>¥80,000</strong></article>
        </div>
        <div class="rate-notes">
          <p>Additional hour — ¥10,000</p>
          <p><strong>Prices are per guide, not per person.</strong></p>
          <p>Guiding service only. Transportation, meals, admission fees, taxi fares and personal expenses are separate.</p>
        </div>
      </section>

      <section id="about" class="split-section wrap about-section">
        <div class="copy-panel">
          <p class="eyebrow">YOUR GUIDE</p>
          <h2>Hi, I'm Don.</h2>
          <p>I was born and raised in Kyoto and am a National Government Licensed Guide Interpreter.</p>
          <p>I have also spent many years overseas, so I understand both Kyoto and some of the questions and small difficulties international visitors may experience in Japan.</p>
          <p>I personally plan and guide each tour.</p>
        </div>
        <div class="image-panel portrait"><img src="/don.jpg" alt="Don Tanaka, private Kyoto guide" loading="lazy" decoding="async" /></div>
      </section>

      <section id="contact" class="final-cta">
        <div class="wrap final-inner">
          <p class="eyebrow light">PLAN YOUR DAY</p>
          <h2>Planning a weekend in Kyoto?</h2>
          <p>Tell me your date, group size and what interests you. You do not need to have your itinerary ready.</p>
          <a class="button primary" href="mailto:eltontanaka@gmail.com?subject=Kyoto%20Private%20Guide%20Enquiry">Check Availability</a>
          <small>Sending an enquiry does not confirm a booking.</small>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div><strong>UMA ACADEMIA</strong><p>Private Kyoto Guide — Don Tanaka</p></div>
        <div><a href="#tours">Tours</a><a href="#about">About Don</a><a href="#contact">Contact</a></div>
        <div><a href="/japanese-guide">日本語プライベートガイド</a><a href="/privacy">Privacy</a></div>
      </div>
    </footer>
  </body>
</html>
